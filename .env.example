# PostgreSQL database connection (Supabase Transaction Pooler)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true"

# Prisma migration connection (Supabase Session Pooler)
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres"